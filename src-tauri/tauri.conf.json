{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MSFS Autostart",
  "version": "0.1.0",
  "identifier": "dev.mikn.msfs-autostart",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5231",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MSFS Autostart",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 500,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/thumbnail*.jpg", "**/thumbnail*.png", "**/*.jpg", "**/*.png"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "lib/SimConnect.dll": "lib/SimConnect.dll" },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
